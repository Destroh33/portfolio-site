{/* Centered modal for a belt project's full blurb — a real DOM overlay (not a
   3D Html), so it's crisp, scrollable, and its embed/links work like the
   planet flyby panels. Driven by openBeltProjectAtom; the X (or backdrop /
   Esc) closes it. */}
<div id="belt-modal-root" hidden></div>

<script>
  import { openBeltProjectAtom } from '../../stores/beltModal'
  import { BELT } from '../../data/projects'
  import { shardFacetsSvg } from '../shard'

  const root = document.getElementById('belt-modal-root')!

  function mediaHTML(project: any): string {
    const m = project.media
    if (!m) return ''
    const inner =
      m.type === 'image'
        ? `<img src="${m.src}" alt="${project.name} screenshot" loading="lazy" />`
        : `<iframe src="${m.src}" title="${project.name} embed" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`
    return `<div class="belt-modal-media"><div class="shard-frame">${inner}</div></div>`
  }

  function linksHTML(project: any): string {
    const l = project.links || {}
    const a: string[] = []
    const btn = (href: string, label: string) =>
      `<a class="shard-btn" href="${href}" target="_blank" rel="noreferrer"><span>${label}</span></a>`
    if (l.github) a.push(btn(l.github, 'GitHub'))
    if (l.demo) a.push(btn(l.demo, 'Play'))
    if (l.slides) a.push(btn(l.slides, 'Slides'))
    if (l.youtube) a.push(btn(l.youtube, 'YouTube'))
    return a.length ? `<div class="shard-actions">${a.join('')}</div>` : ''
  }

  function tagsHTML(project: any): string {
    if (!project.tags?.length) return ''
    return `<ul class="shard-tags">${project.tags.map((t: string) => `<li><span>${t}</span></li>`).join('')}</ul>`
  }

  function render(project: any | null) {
    if (!project) {
      root.hidden = true
      root.innerHTML = ''
      return
    }
    root.hidden = false
    const index = BELT.findIndex((p) => p.id === project.id)
    // Rendered already assembled (is-in); the entrance is a CSS keyframe on
    // .belt-modal since this mounts fresh each open.
    root.innerHTML = `
      <div class="belt-modal-backdrop" data-close></div>
      <div class="belt-modal shard is-in" role="dialog" aria-modal="true" aria-label="${project.name}">
        <div class="shard-plate">
          <h2>${project.name}</h2>
        </div>
        <div class="shard-panel">
          <div class="shard-bg" aria-hidden="true">${shardFacetsSvg(index + 5)}</div>
          <div class="shard-content">
            <button class="belt-modal-close" aria-label="Close" data-close>&times;</button>
            <p>${project.description}</p>
            ${tagsHTML(project)}
            ${mediaHTML(project)}
            ${linksHTML(project)}
          </div>
        </div>
      </div>
    `
    root.querySelectorAll('[data-close]').forEach((el) =>
      el.addEventListener('click', () => openBeltProjectAtom.set(null)),
    )
  }

  openBeltProjectAtom.subscribe(render)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') openBeltProjectAtom.set(null)
  })
</script>
