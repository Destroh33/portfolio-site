{/* The curved title/buttons now live in 3D space (scene/HeroSurfaceCard.tsx,
   anchored to the asteroid surface) so they get real camera perspective.
   This overlay is just the 2D scroll-hint chevron, fading via introBlendAtom. */}
<div id="intro-scroll-cue" aria-hidden="true">
  <span>Scroll</span>
  <span class="chevron"></span>
</div>

<script>
  import { introBlendAtom } from '../../stores/introLayout'

  const cue = document.getElementById('intro-scroll-cue')

  introBlendAtom.subscribe((blend) => {
    if (cue) cue.style.opacity = String(1 - blend)
  })
</script>
