---
import { SITE_LINKS } from '../../data/site'
---

{/* Real accessible content, visually hidden — no visible 2D presentation yet;
   a 3D end-of-flight panel is a follow-up. */}
<div id="contact" class="section-spacer">
  <section class="sr-only">
    <h2>Contact</h2>
    <p>Want to get in touch or see more? Find me here:</p>
    <div class="link-row">
      {SITE_LINKS.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))}
    </div>
  </section>
</div>
