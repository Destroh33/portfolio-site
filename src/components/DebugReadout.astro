{
  import.meta.env.DEV && (
    <div id="debug-readout" style="position:fixed;bottom:8px;left:8px;z-index:9999;font:11px/1.4 monospace;background:rgba(0,0,0,0.7);color:#7dd3fc;padding:6px 8px;border-radius:4px;pointer-events:none;white-space:pre;">
      loading…
    </div>
  )
}

<script>
  import { scrollProgressAtom } from '../stores/scrollProgress'
  import { flybySequenceAtom, scrollLockedAtom } from '../stores/flybySequence'

  const el = document.getElementById('debug-readout')
  if (el) {
    const render = () => {
      const progress = scrollProgressAtom.get().toFixed(3)
      const seq = flybySequenceAtom.get()
      const locked = scrollLockedAtom.get()
      el.textContent =
        `scrollProgress: ${progress}\n` +
        `state: ${seq.state}  active: ${seq.activeId ?? '-'}\n` +
        `blend: ${seq.blend.toFixed(2)}  locked: ${locked}`
    }
    scrollProgressAtom.subscribe(render)
    flybySequenceAtom.subscribe(render)
    scrollLockedAtom.subscribe(render)
    render()
  }
</script>
